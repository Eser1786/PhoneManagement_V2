<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Chỉ là vùng nội dung. Sidebar + thanh trên cùng do MainLayout lo. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phonestore.gui.OrderController"
      styleClass="ord-page" stylesheets="@../css/order.css" spacing="20">

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label styleClass="ord-title" text="Quản lý đơn hàng"/>
            <Label styleClass="ord-subtitle" text="Theo dõi, lọc đơn hàng, cập nhật trạng thái và in hóa đơn"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="ord-outline-btn" text="Làm mới" onAction="#onRefresh"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" styleClass="ord-search" prefWidth="300"
                   promptText="Tìm theo mã đơn hoặc tên khách"/>
        <ComboBox fx:id="statusFilter" styleClass="ord-combo" prefWidth="180"/>
        <DatePicker fx:id="fromDate" styleClass="ord-date" prefWidth="150" promptText="Từ ngày"/>
        <DatePicker fx:id="toDate" styleClass="ord-date" prefWidth="150" promptText="Đến ngày"/>
        <Button styleClass="ord-ghost-btn" text="Xóa bộ lọc" onAction="#onResetFilters"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="ord-count" text="0 đơn hàng"/>
    </HBox>

    <VBox styleClass="ord-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="ord-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"      text="MÃ ĐƠN"       prefWidth="90"  sortable="false"/>
                <TableColumn fx:id="colCustomer" text="KHÁCH HÀNG"  prefWidth="200" sortable="false"/>
                <TableColumn fx:id="colDate"    text="NGÀY ĐẶT"     prefWidth="140" sortable="false"/>
                <TableColumn fx:id="colTotal"   text="TỔNG TIỀN"    prefWidth="140" sortable="false"/>
                <TableColumn fx:id="colMethod"  text="THANH TOÁN"   prefWidth="130" sortable="false"/>
                <TableColumn fx:id="colStatus"  text="TRẠNG THÁI"   prefWidth="130" sortable="false"/>
                <TableColumn fx:id="colActions" text="THAO TÁC"     prefWidth="100" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
