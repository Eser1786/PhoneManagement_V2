<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.phonestore.gui.InventoryController"
            stylesheets="@../css/style.css">

    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>

    <!-- Header -->
    <top>
        <VBox spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Quản lý kho hàng" styleClass="page-title"/>
                    <Label text="Theo dõi tồn kho, cảnh báo sắp hết, lập phiếu nhập/xuất và lịch sử giao dịch"
                           styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblLowStockAlert" text="Cảnh báo tồn thấp: 0" styleClass="badge-warning"/>
                <Button text="Làm mới" onAction="#handleRefresh" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <!-- Nội dung chính -->
    <center>
        <TabPane fx:id="tabPaneInventory" tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>

            <!-- TAB 1: TỒN KHO & CẢNH BÁO -->
            <Tab text="Tồn kho &amp; Cảnh báo">
                <VBox spacing="12">
                    <padding>
                        <Insets top="12" right="4" bottom="8" left="4"/>
                    </padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtSearchStock"
                                   promptText="Tìm theo tên sản phẩm, RAM, bộ nhớ, màu..."
                                   prefWidth="320"/>
                        <ComboBox fx:id="cmbStockFilter" prefWidth="200"/>
                        <Spinner fx:id="spnLowStockThreshold" prefWidth="110" editable="true"/>
                        <Button text="Lọc" onAction="#handleFilterStock" styleClass="btn-primary"/>
                        <Button text="Xóa lọc" onAction="#handleResetStockFilter" styleClass="btn-secondary"/>
                    </HBox>

                    <TableView fx:id="tblStock" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSpecId" text="Mã cấu hình" prefWidth="100"/>
                            <TableColumn fx:id="colProductName" text="Tên sản phẩm" prefWidth="220"/>
                            <TableColumn fx:id="colRam" text="RAM" prefWidth="90"/>
                            <TableColumn fx:id="colStorage" text="Bộ nhớ" prefWidth="100"/>
                            <TableColumn fx:id="colColor" text="Màu sắc" prefWidth="110"/>
                            <TableColumn fx:id="colStockQty" text="Tồn kho" prefWidth="100"/>
                            <TableColumn fx:id="colStockStatus" text="Trạng thái" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 2: LẬP PHIẾU NHẬP / XUẤT KHO -->
            <Tab text="Nhập / Xuất kho">
                <VBox spacing="16">
                    <padding>
                        <Insets top="16" right="8" bottom="16" left="8"/>
                    </padding>

                    <GridPane hgap="14" vgap="12" styleClass="form-card">
                        <Label text="Loại phiếu:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbMovementType" prefWidth="220"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Sản phẩm / Cấu hình:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbTargetSpec" prefWidth="420"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Số lượng:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtQuantity" promptText="Nhập số nguyên dương (VD: 10)"
                                   prefWidth="220" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Mã phiếu / Tham chiếu:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtReferenceCode" promptText="VD: PN-20261124-01 (tùy chọn)"
                                   prefWidth="260" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Ghi chú:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNote" promptText="Lý do nhập/xuất kho..."
                                   prefWidth="420" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>

                    <HBox spacing="12">
                        <Button fx:id="btnSubmitMovement" text="Xác nhận phiếu kho"
                                onAction="#handleSubmitMovement" styleClass="btn-primary"/>
                        <Button text="Xóa form" onAction="#handleClearMovementForm"
                                styleClass="btn-secondary"/>
                        <Label fx:id="lblMovementInfo" styleClass="info-text"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 3: LỊCH SỬ KHO -->
            <Tab text="Lịch sử giao dịch">
                <VBox spacing="12">
                    <padding>
                        <Insets top="12" right="4" bottom="8" left="4"/>
                    </padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtSearchHistory"
                                   promptText="Tìm theo mã phiếu, tên sản phẩm, ghi chú..."
                                   prefWidth="320"/>
                        <ComboBox fx:id="cmbHistoryTypeFilter" prefWidth="180"/>
                        <Button text="Tìm kiếm" onAction="#handleFilterHistory" styleClass="btn-primary"/>
                        <Button text="Đặt lại" onAction="#handleResetHistoryFilter" styleClass="btn-secondary"/>
                    </HBox>

                    <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colReceiptId" text="Mã phiếu" prefWidth="130"/>
                            <TableColumn fx:id="colHistoryProductName" text="Tên sản phẩm" prefWidth="210"/>
                            <TableColumn fx:id="colHistorySpec" text="Cấu hình" prefWidth="150"/>
                            <TableColumn fx:id="colHistoryType" text="Loại GD" prefWidth="110"/>
                            <TableColumn fx:id="colHistoryQty" text="Số lượng" prefWidth="100"/>
                            <TableColumn fx:id="colHistoryNote" text="Ghi chú" prefWidth="220"/>
                            <TableColumn fx:id="colCreatedDate" text="Ngày tạo" prefWidth="160"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>