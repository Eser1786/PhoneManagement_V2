<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootView" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.phonestore.gui.SalesController">

    <HBox spacing="16.0" styleClass="page-container">

        <!-- KHU VỰC TRÁI: DANH SÁCH SẢN PHẨM ĐỂ CHỌN -->
        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="txtSearchProduct" prefWidth="250.0" promptText="Tìm sản phẩm mua..." styleClass="app-input" />
                <ComboBox fx:id="cbCategoryFilter" prefWidth="170.0" promptText="Danh mục" styleClass="app-combo" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <TableView fx:id="tblCatalog" styleClass="app-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCatName" prefWidth="220.0" text="Tên sản phẩm &amp; Cấu hình" />
                    <TableColumn fx:id="colCatPrice" prefWidth="120.0" text="Giá bán" />
                    <TableColumn fx:id="colCatStock" prefWidth="80.0" text="Tồn kho" />
                    <TableColumn fx:id="colCatAction" prefWidth="95.0" text="Thao tác" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- KHU VỰC PHẢI: GIỎ HÀNG & THANH TOÁN -->
        <VBox prefWidth="450.0" spacing="12.0" styleClass="app-card">
            <Label styleClass="dash-section-title" text="Giỏ hàng hiện tại" />

            <!-- Bảng giỏ hàng -->
            <TableView fx:id="tblCart" prefHeight="240.0" styleClass="app-table">
                <columns>
                    <TableColumn fx:id="colCartName" prefWidth="150.0" text="Sản phẩm" />
                    <TableColumn fx:id="colCartQty" prefWidth="105.0" text="SL" />
                    <TableColumn fx:id="colCartPrice" prefWidth="115.0" text="Thành tiền" />
                    <TableColumn fx:id="colCartAction" prefWidth="55.0" text="Xóa" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Thông tin khách hàng & thanh toán -->
            <VBox spacing="8.0">
                <Label styleClass="dash-card-title" text="THÔNG TIN THANH TOÁN" />

                <ComboBox fx:id="cbCustomer" maxWidth="Infinity" promptText="Khách vãng lai (hoặc chọn khách hàng)" styleClass="app-combo" />

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Thanh toán:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="cbPaymentMethod" prefWidth="180.0" styleClass="app-combo" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Chiết khấu (%):" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtDiscountPercent" prefWidth="120.0" promptText="0" text="0" styleClass="app-input" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Ghi chú:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtOrderNote" prefWidth="240.0" promptText="Ghi chú đơn hàng..." styleClass="app-input" />
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Tạm tính:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblGrossTotal" text="0₫" />
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Tổng thanh toán:" styleClass="dash-card-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSubTotal" styleClass="dash-card-title" text="0₫" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Tiền khách đưa:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtCashPaid" prefWidth="160.0" promptText="0" styleClass="app-input" />
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Tiền thừa trả khách:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblChangeReturn" styleClass="page-title" text="0₫"
                           style="-fx-font-size: 16px; -fx-text-fill: #4e2a84;" />
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#onCheckout" styleClass="app-btn-primary" text="Xác nhận thanh toán" />
        </VBox>

    </HBox>
</StackPane>